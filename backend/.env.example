NODE_ENV=development

PORT=3000
CORS_ORIGIN=http://localhost:5173

# ---------------------------------------------------------------------------
# Data stores
# ---------------------------------------------------------------------------
# Required — the server throws at boot without it.
MONGO_URI=
REDIS_URL=redis://127.0.0.1:6379

# ---------------------------------------------------------------------------
# AI provider (course + lesson generation, and Hinglish translation)
# ---------------------------------------------------------------------------
AI_PROVIDER=gemini

# Both required — the server throws at boot without the key.
# One key, one quota: course generation, lesson generation and translation all
# spend from the same allowance, so a busy translation run competes with the
# feature nobody can do without.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# ---------------------------------------------------------------------------
# Hinglish translation (optional feature; no extra key required)
# ---------------------------------------------------------------------------
# Concurrency sits BELOW the lesson worker's on purpose — see the shared-quota
# note above. A translation is a derived artifact; a lesson is not.
TRANSLATION_WORKER_CONCURRENCY=2

# Strings are translated in batches rather than a lesson at a time. Asking for a
# whole lesson in one response is where models start truncating and silently
# dropping entries; a smaller response comes back whole, and a failure costs one
# batch rather than the lesson.
TRANSLATION_BATCH_MAX_ITEMS=25
TRANSLATION_BATCH_MAX_CHARS=6000

# ---------------------------------------------------------------------------
# Text-to-speech (optional feature; uses the same GEMINI_API_KEY)
# ---------------------------------------------------------------------------
# READ THIS BEFORE ENABLING. On the Gemini FREE tier the TTS model allows ten
# requests per DAY, and one lesson costs one request per section — so a free key
# supports roughly two lessons of narration for the entire application, shared
# across every user. See AI_TTS_DAILY_REQUEST_BUDGET below.
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
TTS_VOICE=Kore
TTS_LANGUAGE=en

# Concurrency 1 deliberately. Several workers each firing a lesson's worth of
# requests is the fastest way to trip the model's rate limit, and the reader does
# not need section 4 early — they need section 1 now, which progressive playback
# already gives them.
TTS_WORKER_CONCURRENCY=1
TTS_JOB_ATTEMPTS=3

# Roughly 90 seconds of speech per section. Audio is cut at heading boundaries so
# playback can start on the first section while the rest are still being made;
# one request for a whole lesson would be minutes of silence.
TTS_SEGMENT_MAX_CHARS=1800
TTS_MAX_SEGMENTS=30
TTS_SEGMENT_DELAY_MS=500

# ---------------------------------------------------------------------------
# AI daily budget — a local guard rail in front of the provider's own quota
# ---------------------------------------------------------------------------
# Without this the application discovers exhaustion one 429 at a time: every
# rejection arrives in milliseconds, so a job burns its whole retry budget in
# seconds and reports "failed after 3 attempts" when the truth is "out until
# tomorrow". With it, the API refuses up front with a readable 503 and never
# queues a job that cannot succeed.
#
# The TTS default matches the free tier exactly. On a PAID key set both to 0 to
# disable the local check and let the provider's own limits be the only ones.
AI_DAILY_REQUEST_BUDGET=200
AI_TTS_DAILY_REQUEST_BUDGET=10

# ---------------------------------------------------------------------------
# Auth0 — both required
# ---------------------------------------------------------------------------
# A Post-Login Action must add namespaced email/name/picture claims under
# https://eduforge.app, or attachUser fails with AUTH0_CLAIMS_MISCONFIGURED.
AUTH0_ISSUER=
AUTH0_AUDIENCE=

# ---------------------------------------------------------------------------
# Video enrichment (optional)
# ---------------------------------------------------------------------------
# Unlike the AI key, a missing YOUTUBE_API_KEY does NOT stop the server: video
# resolution is an enrichment pass, and a lesson is fully usable without it.
# Slots simply settle FAILED and the reader sees no video.
#
# If the key is restricted, prefer an API restriction (YouTube Data API v3) over
# an IP restriction — a server's address changes, and a dynamic residential IP
# will break it constantly.
VIDEO_PROVIDER=youtube
YOUTUBE_API_KEY=

# Quota is the binding constraint here. search.list costs 100 units against a
# 10,000/day default — roughly 100 searches per DAY for the whole application,
# shared across all users. videos.list costs 1, so filtering is nearly free.
# The reserve is held back so enrichment can never consume the entire budget.
YOUTUBE_DAILY_QUOTA_UNITS=10000
YOUTUBE_QUOTA_RESERVE=1000

# Resolved searches are cached by normalized query; this is the single biggest
# quota saver, since lessons on adjacent topics produce near-identical searches.
YOUTUBE_CACHE_TTL_DAYS=30

# Candidate filter bounds, in seconds. Below the minimum is usually a teaser;
# above the maximum is usually a full lecture rather than a lesson aid.
YOUTUBE_MIN_DURATION_S=180
YOUTUBE_MAX_DURATION_S=1800

VIDEO_JOB_ATTEMPTS=3

# A slot that exhausts its attempts is revived at most MAX_ROUNDS times, and
# never sooner than the cooldown, when someone next opens that lesson. This is
# what recovers slots that failed during an outage (revoked key, quota wall, API
# down) without re-spending quota on a query that will never resolve.
VIDEO_RETRY_MAX_ROUNDS=2
VIDEO_RETRY_COOLDOWN_MS=21600000

# ---------------------------------------------------------------------------
# Queues and workers
# ---------------------------------------------------------------------------
QUEUE_ATTEMPTS=3
QUEUE_BACKOFF_TYPE=exponential
QUEUE_BACKOFF_DELAY=2000

# All five workers run in the SAME process (npm run worker). The readiness probe
# at /api/ready requires one attached to every queue, so it reports not-ready if
# any of them fails to start.
COURSE_WORKER_CONCURRENCY=2
LESSON_WORKER_CONCURRENCY=3
VIDEO_WORKER_CONCURRENCY=2
# Also set in the translation and text-to-speech sections above; listed here so
# the full worker picture is in one place.
# TRANSLATION_WORKER_CONCURRENCY=2
# TTS_WORKER_CONCURRENCY=1

# Transactional outbox. The publisher runs ONLY in the worker process
# (npm run worker) — without it, nothing is ever dispatched to a queue.
OUTBOX_POLL_INTERVAL_MS=2000
OUTBOX_BATCH_SIZE=10
OUTBOX_MAX_ATTEMPTS=10

# ---------------------------------------------------------------------------
# Rate limiting (per user, Redis-backed)
# ---------------------------------------------------------------------------
# Tiered because the routes cost wildly different amounts, and one bucket for all
# of them prices abuse the same as ordinary use. Each tier is its own bucket, so
# exhausting the expensive one never locks a reader out of the lesson they have.
#
#   read        cheap and frequent — the baseline on every authenticated route
#   write       a database write, no provider call
#   stream      SSE; each open stream holds a dedicated Redis subscriber, so this
#               caps concurrent server resources, not just request volume
#   generation  ONE provider call: course, lesson, or translation
#   audio       one provider call PER SECTION — worth roughly 4-15 of the tier
#               above, which is why it is an order of magnitude tighter
RATE_LIMIT_READ_MAX=300        # per 15 minutes
RATE_LIMIT_WRITE_MAX=100       # per 15 minutes
RATE_LIMIT_STREAM_MAX=60       # per 5 minutes
RATE_LIMIT_GENERATION_MAX=20   # per hour
RATE_LIMIT_AUDIO_MAX=5         # per hour

# ---------------------------------------------------------------------------
# Caching
# ---------------------------------------------------------------------------
# Only user statistics are cached: three aggregations that both the dashboard and
# the profile page request, so one page view can run them twice. Everything else
# is a single indexed query against one user's own documents, where a cache would
# buy little and add an invalidation path to every write.
#
# Invalidated explicitly when a lesson is completed or a question answered, so a
# reader sees their own progress immediately. This TTL is the backstop for
# everything else that touches the underlying documents.
STATS_CACHE_TTL_SECONDS=60

# ---------------------------------------------------------------------------
# Cloudinary (profile pictures AND generated lesson audio) — required
# ---------------------------------------------------------------------------
# cloudinary://<api_key>:<api_secret>@<cloud_name>
#
# Audio is stored under resource_type 'video' (that is simply how Cloudinary
# addresses its media pipeline) in eduforge/tts/<lessonId>/. WAV is uploaded and
# transcoded to mp3 on the way in, which is about a fifth of the bytes.
CLOUDINARY_URL=
