NODE_ENV=development

PORT=3000
CORS_ORIGIN=http://localhost:5173

#mongo and redis
MONGO_URI=
REDIS_URL=REDIS_URL=

#ai provider
AI_PROVIDER=gemini

#gemini
GEMINI_API_KEY=
GEMINI_MODEL=

#AUTH0
AUTH0_ISSUER=
AUTH0_AUDIENCE=

YOUTUBE_API_KEY=

#queue
QUEUE_ATTEMPTS = 3
QUEUE_BACKOFF_TYPE = exponential
QUEUE_BACKOFF_DELAY = 2000

#concurrency
COURSE_WORKER_CONCURRENCY = 2
LESSON_WORKER_CONCURRENCY = 3

# Outbox
OUTBOX_POLL_INTERVAL_MS=2000
OUTBOX_BATCH_SIZE=10
OUTBOX_MAX_ATTEMPTS=10
